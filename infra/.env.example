# Banana Chat deploy variables for the prod/staging compose stacks (DEC-045).
#
#   cp infra/.env.example infra/.env    # then edit — infra/.env is gitignored
#
# `make up-prod` / `make up-staging` pass this file via --env-file automatically
# (present-if-exists; without it compose reads plain env vars / repo-root .env).
# Everything below matches the baked-in defaults — delete or comment out lines
# you don't need; only the values you CHANGE have to stay.
#
# Staging (docker-compose.staging.yml overlay) overrides the marked defaults;
# anything you set here applies to BOTH stacks, so set per-stack values in the
# shell instead (HTTP_PORT=9000 make up-staging).

# ---- edge ----

# Host port the nginx edge publishes. prod: 80 · staging: 8081 (8080 is
# docker-desktop's on dev Macs)
#HTTP_PORT=80

# ---- web build (baked into the SPA image — change ⇒ rebuild the nginx image) ----

#VITE_API_BASE=/api/v1
# Public hostname browsers use for websockets. Without a real hostname the
# localhost default works for same-machine smoke tests only.
#VITE_REVERB_HOST=localhost
#VITE_REVERB_PORT=80
#VITE_REVERB_SCHEME=http

# ---- Reverb ----

# Must match between the API env and the web build (VITE_REVERB_APP_KEY).
# Defaults are fine for private/localhost deploys; set real values for
# anything internet-adjacent — and rebuild the nginx image after changing.
#REVERB_APP_KEY=banana-chat-key
#REVERB_APP_SECRET=banana-chat-secret

# ---- data stores (compose-internal; not published to the host) ----

# The first-run wizard (/setup) writes whatever you type there into
# apps/api/.env (prod) / apps/api/.env.staging (staging) — keep these in
# sync so the installer's defaults match the containers.
#POSTGRES_USER=orgchat
#POSTGRES_PASSWORD=orgchat          # CHANGE for anything internet-adjacent
#POSTGRES_DB=orgchat

# MinIO root creds double as the S3 creds the API uses (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY in the stack).
#MINIO_ROOT_USER=orgchat
#MINIO_ROOT_PASSWORD=orgchat123     # CHANGE for anything internet-adjacent
# Console port, localhost-only. prod: 9101 · staging: 9201
#MINIO_CONSOLE_PORT=9101

# Container-direct uploads by default. For browser-fetchable presigned URLs
# use the edge HOST ROOT (no /storage path — SigV4 signs the endpoint path,
# and MinIO must receive exactly what was signed; DEC-046):
#AWS_ENDPOINT=https://chat.example.com

# ---- workers ----

# Horizon AI supervisor process count (TASK-INF-014, NFR-OPS-011).
# prod: 4 · staging/dev: 2
#HORIZON_AI_PROCESSES=4
