# Banana Chat API — copy to .env and adjust (spec Appendix A)
# Dev defaults assume `make up` (dockerized pg/redis/minio/mailpit/reverb on mapped ports)

APP_NAME="Banana Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=orgchat
DB_USERNAME=orgchat
DB_PASSWORD=orgchat

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=banana_chat

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# Mailpit (dev)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@banana-chat.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible)
AWS_ACCESS_KEY_ID=orgchat
AWS_SECRET_ACCESS_KEY=orgchat123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=orgchat
AWS_ENDPOINT=http://127.0.0.1:9100
AWS_URL=http://127.0.0.1:9100
AWS_USE_PATH_STYLE_ENDPOINT=true

# Reverb (WebSocket). API POSTs events to REVERB_HOST:REVERB_PORT;
# host runs Reverb in docker published on 8088 (8080 is taken by Docker Desktop).
REVERB_APP_ID=banana-chat
REVERB_APP_KEY=banana-chat-key
REVERB_APP_SECRET=banana-chat-secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8088
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
MOBILE_MIN_SUPPORTED_VERSION=1.0.0

ADMIN_IP_ALLOWLIST=

# ---- AI provider (FR-AI-019 / TASK-INF-014) ----
# Functional knobs (model, key, prompts) live in the ai_providers table
# (Filament → AI Providers); these are infrastructure-level only.
AI_RETRY_BACKOFF=true
AI_ALLOW_PRIVATE_HOSTS=false
# mock provider for dev/CI/load: docker compose up mock-ai (or make dev-mock-ai)
# then create a provider row with base_url=http://127.0.0.1:8787/v1
AI_BREAKER_THRESHOLD=20
AI_BREAKER_OPEN_SECONDS=60
AI_ALERT_ERROR_WINDOW=5

# Horizon — ai supervisor concurrency (NFR-OPS-011; timeout fixed at 660s)
HORIZON_AI_PROCESSES=2

# ---- ClamAV virus scan (FR-MEDIA-006 / TASK-INF-010) ----
# Host dev: compose maps the container to 127.0.0.1:3310. Unreachable daemon
# => files are marked scan_result=skipped (with an alert log), never failed.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_ENABLED=true

# ---- First-run installer (FR-SETUP / DEC-043) ----
# A fresh instance with no APP_KEY opens the WordPress-style wizard at /setup,
# which writes these values itself. Unset here on purpose: setting it to true
# would mark an unconfigured instance as installed. Flip to false to force the
# wizard open again.
#SETUP_COMPLETED=false

# FR-CALL-005 (disabled until signaling and TURN are verified)
CALLS_ENABLED=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=http://livekit:7880
