<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env force="true" name="APP_ENV" value="testing"/>
        <!-- signed media URLs are generated from APP_URL; pin so the cloud .env
             (or a different port) can't break signature validation in tests -->
        <env name="APP_URL" value="http://localhost"/>
        <env force="true" name="APP_KEY" value="base64:2fl+Ktvkfl+Fuz4Qp/A75G2RTiWVA/ZoKZvp6fiiM10="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="HASH_ARGON_MEMORY" value="8192"/>
        <env name="HASH_ARGON_TIME" value="2"/>
        <env name="HASH_ARGON_THREADS" value="1"/>
        <!-- reverb: run the real Pusher-compatible auth path (socket_auth is a local
             HMAC — no network) so channel closures are enforced in tests (TC-RT-*) -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env force="true" name="CACHE_STORE" value="array"/>
        <!-- Postgres required: citext / tsvector / pg_trgm (spec §12.1 — never SQLite) -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env force="true" name="DB_DATABASE" value="orgchat_test"/>
        <env name="DB_USERNAME" value="orgchat"/>
        <env name="DB_PASSWORD" value="orgchat"/>
        <!-- local docker pg has no TLS — neutralize cloud .env values -->
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <env force="true" name="QUEUE_CONNECTION" value="sync"/>
        <env force="true" name="SESSION_DRIVER" value="array"/>
        <env name="REDIS_CLIENT" value="phpredis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6380"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- tests must NEVER reach cloud storage: pin the local disk and dummy
             AWS creds regardless of which infra .env currently points at -->
        <env force="true" name="FILESYSTEM_DISK" value="local"/>
        <env force="true" name="AWS_ACCESS_KEY_ID" value="testing"/>
        <env force="true" name="AWS_SECRET_ACCESS_KEY" value="testing"/>
        <env name="AWS_DEFAULT_REGION" value="us-east-1"/>
        <env force="true" name="AWS_BUCKET" value="testing"/>
        <env force="true" name="AWS_ENDPOINT" value="http://127.0.0.1:9100"/>
        <env force="true" name="AWS_ROOT" value=""/>
        <env force="true" name="AWS_URL" value=""/>
    </php>
</phpunit>
