{
  "name": "@banana-chat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@banana-chat/api-client": "workspace:*",
    "@banana-chat/chat-core": "workspace:*",
    "@banana-chat/shared": "workspace:*",
    "@shopify/flash-list": "^2.3.2",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.0",
    "laravel-echo": "^1.17.1",
    "pusher-js": "^8.4.0-rc2",
    "react": "19.2.6",
    "react-native": "~0.87.1",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.0",
    "better-sqlite3": "^13.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^vitest$": "<rootDir>/src/test/vitest-shim.ts",
      "^@banana-chat/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^@banana-chat/api-client$": "<rootDir>/../../packages/api-client/src/index.ts",
      "^@banana-chat/chat-core$": "<rootDir>/../../packages/chat-core/src/index.ts",
      "^@banana-chat/chat-core/contract$": "<rootDir>/../../packages/chat-core/src/cache.contract.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "resolveJsonModule": true,
            "jsx": "react-jsx"
          }
        }
      ]
    }
  }
}
